@if(this.Inventory is not null)
{
    <tr>
        <td>@Inventory.InventoryName</td>
        <td>@Inventory.Quantity</td>

        @* HTML entity used for currency type and N2 format specifier for number *@
        <td>&#8358;@Inventory.Price.ToString("N2")</td>
        <td>
            <a href="/editinventory/@Inventory.InventoryId" class="btn btn-light">Edit</a>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Inventory? Inventory { get; set; }
}
